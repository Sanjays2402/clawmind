# Core
CLAWMIND_DATA_DIR=./data
CLAWMIND_WORKSPACE=~/.openclaw/workspace
CLAWMIND_LOG_LEVEL=info

# API
CLAWMIND_API_HOST=127.0.0.1
CLAWMIND_API_PORT=7410
CLAWMIND_API_CORS_ORIGIN=http://127.0.0.1:7412

# Embed sidecar
CLAWMIND_EMBED_URL=http://127.0.0.1:7411
CLAWMIND_EMBED_MODEL=mlx-community/bge-small-en-v1.5-4bit
CLAWMIND_EMBED_DIM=384

# LLM
CLAWMIND_LLM_PRIMARY_URL=http://127.0.0.1:8642/v1
CLAWMIND_LLM_PRIMARY_MODEL=hermes-agent
CLAWMIND_LLM_FALLBACK_URL=http://127.0.0.1:4141/v1
CLAWMIND_LLM_FALLBACK_MODEL=copilot-gpt-4o

# Auth (single-user mode is default; OAuth enables multi)
CLAWMIND_AUTH_MODE=single-user
CLAWMIND_SESSION_SECRET=replace-me-with-random-32-bytes
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
CLAWMIND_ALLOWED_GITHUB_USERS=

# Web
NEXT_PUBLIC_API_URL=http://127.0.0.1:7410

# Telemetry
CLAWMIND_OTEL_ENABLED=false
CLAWMIND_OTEL_ENDPOINT=http://127.0.0.1:4318

# Sentry error tracking (empty DSN disables it; no events are sent)
CLAWMIND_SENTRY_DSN=
CLAWMIND_SENTRY_ENVIRONMENT=development
CLAWMIND_SENTRY_RELEASE=
CLAWMIND_SENTRY_TRACES_SAMPLE_RATE=0

# Audit log rotation. The active audit.log rotates once it exceeds MAX_BYTES.
# KEEP_FILES rotated siblings are retained (audit.log.1, audit.log.2, ...).
# Set MAX_BYTES=0 to disable rotation.
CLAWMIND_AUDIT_MAX_BYTES=33554432
CLAWMIND_AUDIT_KEEP_FILES=5

# Security headers. HSTS is opt-in because the default bind is plain HTTP on
# 127.0.0.1; enable it in production deployments behind a TLS ingress.
CLAWMIND_HSTS_ENABLED=false
CLAWMIND_HSTS_MAX_AGE_SECONDS=15552000
